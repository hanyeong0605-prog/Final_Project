# Do not commit the real version of this file.
DB_URL=jdbc:mysql://final-staging-jobpilot-mysql.cb0gee02yxdk.ap-northeast-2.rds.amazonaws.com:3306/jobpilot?useSSL=true&requireSSL=true&serverTimezone=Asia/Seoul
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_VALUE_WITH_AT_LEAST_32_BYTES
INTERNAL_API_KEY=CHANGE_ME_TO_A_RANDOM_VALUE
CORS_ALLOWED_ORIGINS=http://YOUR_ELASTIC_IP_OR_DOMAIN
# This is a browser JavaScript key. It is public by design; restrict it by Web platform domain in Kakao Developers.
VITE_KAKAO_MAP_KEY=YOUR_KAKAO_JAVASCRIPT_KEY

# 2026-08-10: 구독 결제(Toss Payments). client key는 프론트 빌드에 그대로 박히는 공개
# 값이고(docker-compose.prod.yml build args로 전달됨), secret key는 백엔드가
# 결제 승인(confirm) API를 호출할 때만 서버 안에서 쓰는 비공개 값 - 절대 프론트로
# 넘어가면 안 된다. 지금은 테스트 키(test_ck_/test_sk_)만 사용 중이라 실제 결제는
# 발생하지 않는다. 실서비스 전환 시 라이브 키(live_ck_/live_sk_)로 교체.
VITE_TOSS_CLIENT_KEY=YOUR_TOSS_CLIENT_KEY
TOSS_SECRET_KEY=YOUR_TOSS_SECRET_KEY

BARUN_API_KEY=
CAREER_API_KEY=
# Public Data Portal / Q-Net service key. Keep it only in the EC2 env file.
QNET_API_KEY=
# Aladin TTB Open API key. Keep it only in /etc/jobpilot/jobpilot.env.
ALADIN_TTB_KEY=
# OAuth provider credentials belong only in the server environment file.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
OAUTH_KAKAO_REST_API_KEY=
OAUTH_KAKAO_CLIENT_SECRET=
# Public URL where Spring redirects after social login.
OAUTH_SUCCESS_REDIRECT=https://job-a-dream.site/oauth/callback
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
OPENAI_API_KEY=
GITHUB_TOKEN=
# Use the same value for both entries when one shared Gemini key is intended.
# Or use separate project keys to split ownership, quota, and cost tracking.
GEMINI_API_KEY_BACKEND=
GEMINI_API_KEY_AI=
GOOGLE_TTS_API_KEY=
# 2026-08-07: 모의면접 답변 STT(Google Cloud Speech-to-Text)용. GOOGLE_TTS_API_KEY와 같은
# GCP 프로젝트 키를 재사용해도 된다 - 단, 그 프로젝트에서 Speech-to-Text API도 활성화돼
# 있어야 한다(Cloud Console > API 및 서비스 > 라이브러리에서 활성화). 없어도 서버는 뜨고
# fail-open으로 STT만 비활성화된다(ai-server/app/domain/interview/audio_analysis.py 참고).
GOOGLE_STT_API_KEY=

# 2026-08-10: EC2 프리티어에는 LoRA 모델 파일이 없어서(question_generator.py 모듈 docstring
# 참고, app/domain/interview/model/은 저장소에서 .gitignore로 빠짐), "직접 학습시킨 모델이
# 실서비스에서 실제로 동작한다"를 보여주려면 Tailscale로 연결된 로컬/학원 PC의 LoRA 추론을
# 원격 호출해야 한다. 아래 두 값을 채우면 그 경로가 켜진다 - 비워두면(기본값) 지금처럼
# EC2에선 항상 로컬 모델 파일 없음 -> 코퍼스 폴백으로 동작한다(fail-open, 서비스는 안 죽음).
# LORA_SERVER_URL: 로컬/학원 PC의 Tailscale IP (예: http://100.x.y.z:8000, 포트는 그 PC에서
# uvicorn을 띄운 포트). Tailscale 앱에서 그 PC의 IP를 확인할 수 있다.
LORA_SERVER_URL=
# LORA_SERVER_KEY: 공유 비밀키. 이 값과 로컬 PC의 ai-server/.env에 있는 LORA_SERVER_KEY가
# 같아야 한다(같지 않으면 그 PC의 /internal/lora/generate-candidates가 401을 돌려주고,
# EC2는 fail-open으로 코퍼스 폴백으로 넘어간다).
LORA_SERVER_KEY=

# Keep automatic paid backfill disabled until deliberately enabled.
JOB_REQUIREMENT_BACKFILL_ENABLED=false

# Word-cloud FastAPI cache refresh. The service uses DB_URL, DB_USERNAME, and DB_PASSWORD above.
WORDCLOUD_CACHE_REFRESH_ENABLED=true
WORDCLOUD_CACHE_REFRESH_ON_START=true
WORDCLOUD_CACHE_REFRESH_INTERVAL_MINUTES=360
## Administrator face verification (private server directory, never served by Nginx)
ADMIN_FACE_PHOTOS_DIR=/srv/jobpilot/admin-face-photos
