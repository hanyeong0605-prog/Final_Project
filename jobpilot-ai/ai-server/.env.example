DATABASE_URL=mysql+pymysql://jobpilot:jobpilot@localhost:3306/job
BACKEND_BASE_URL=http://localhost:9000
# 루트 .env의 INTERNAL_API_KEY와 같은 값으로 맞춰야 함
INTERNAL_API_KEY=

# 모의면접 질문생성 결과 검수용 (선택 - 없으면 검수를 건너뛰고 로컬 모델 결과를 그대로 씀).
# 루트 .env의 GEMINI_API_KEY와 같은 값 써도 됨.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 모의면접 질문 낭독용 Google Cloud Text-to-Speech API 키 (선택 - 없으면 브라우저 기본 TTS로
# 자동 폴백). Google Cloud Console에서 프로젝트 생성 -> "Cloud Text-to-Speech API" 사용 설정 ->
# API 및 서비스 > 사용자 인증 정보에서 API 키 발급. 사용량만큼 과금(문자 수 기준, 월 무료
# 할당량 있음) - 결제 계정 연결이 필요하다.
GOOGLE_TTS_API_KEY=
