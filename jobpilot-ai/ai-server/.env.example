DATABASE_URL=mysql+pymysql://jobpilot:jobpilot@localhost:3306/job
BACKEND_BASE_URL=http://localhost:9000
# 루트 .env의 INTERNAL_API_KEY와 같은 값으로 맞춰야 함
INTERNAL_API_KEY=

# 모의면접 질문생성 결과 검수용 (선택 - 없으면 검수를 건너뛰고 로컬 모델 결과를 그대로 씀).
# 루트 .env의 GEMINI_API_KEY와 같은 값 써도 됨.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 모의면접 질문 낭독용 Google Cloud Text-to-Speech API 키 (선택 - 없으면 브라우저 기본 TTS로
# 자동 폴백). Google Cloud Console에서 프로젝트 생성 -> "Cloud Text-to-Speech API" 사용 설정 ->
# API 및 서비스 > 사용자 인증 정보에서 API 키 발급. 사용량만큼 과금(문자 수 기준, 월 무료
# 할당량 있음) - 결제 계정 연결이 필요하다.
GOOGLE_TTS_API_KEY=

# 2026-08-07: 모의면접 답변 STT(Google Cloud Speech-to-Text)용 - 선택, 없으면
# audio_analysis.py transcribe()가 fail-open으로 빈 텍스트를 반환한다. 보통
# GOOGLE_TTS_API_KEY와 같은 GCP 프로젝트 키를 재사용해도 되지만(Speech-to-Text API도
# 활성화돼 있어야 함), 별도 키를 써도 된다.
GOOGLE_STT_API_KEY=

# 2026-08-10: 이 PC를 Tailscale로 EC2에 연결해서 실제 LoRA 추론 서버 역할을 시킬 때만
# 채운다(question_generator.py 모듈 docstring 참고) - 비워두면(로컬 개발 기본값) 지금처럼
# 모델 파일이 있으면 이 프로세스 안에서 직접 로드해서 쓴다. EC2 쪽에만 필요한 값이라
# 이 로컬 PC의 .env에는 보통 비워둔다.
LORA_SERVER_URL=
# 위 URL을 쓸 때만 의미 있음 - EC2와 이 PC 양쪽에 같은 값을 넣는다(공유 비밀키, 헤더로
# 전달됨). Tailscale이 사설망이라 필수는 아니지만 최소한의 방어로 넣어두는 걸 권장.
LORA_SERVER_KEY=
