DATABASE_URL=mysql+pymysql://jobpilot:jobpilot@localhost:3306/job
BACKEND_BASE_URL=http://localhost:9000
# 루트 .env의 INTERNAL_API_KEY와 같은 값으로 맞춰야 함
INTERNAL_API_KEY=

# 모의면접 질문생성 결과 검수용 (선택 - 없으면 검수를 건너뛰고 로컬 모델 결과를 그대로 씀).
# 루트 .env의 GEMINI_API_KEY와 같은 값 써도 됨.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
