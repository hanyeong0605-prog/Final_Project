    varchar notification_type
    varchar title
    varchar body
    varchar url
    tinyint is_read
    tinyint is_hidden
    datetime sent_at
  }

  resume_documents {
    bigint id PK
    bigint member_id FK
    varchar document_type
    varchar title
    varchar original_filename
    varchar template_key
    longtext extracted_text
    longtext generated_content
    json structured_content
    datetime created_at
    datetime updated_at
  }

  resume_entries {
    bigint id PK
    bigint member_id FK
    varchar entry_type
    varchar title
    json content
    int display_order
    datetime created_at
    datetime updated_at
  }

  employer_accounts {
    bigint id PK
    varchar login_id
    varchar email
    varchar password_hash
    varchar manager_name
    varchar manager_phone
    varchar company_name
    varchar business_registration_number
    varchar representative_name
    varchar opening_date
    varchar company_address
    boolean nts_verified
    datetime nts_checked_at
    text nts_raw_response
    varchar status
    varchar rejection_reason
    bigint reviewed_by FK
    datetime reviewed_at
    varchar passwordless_status
    varchar passwordless_user_id
    datetime passwordless_activated_at
    datetime passwordless_last_verified_at
    datetime created_at
    datetime updated_at
  }

  employer_notifications {
    bigint id PK
    bigint employer_account_id FK
    bigint member_id FK
    bigint job_posting_id FK
    varchar title
    varchar body
    varchar url
    boolean is_read
    datetime created_at
  }
  member_resume_save_states {
    bigint member_id PK, FK
    varchar save_status
