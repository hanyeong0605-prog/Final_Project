# backend
DB_URL=jdbc:mysql://localhost:3306/jobpilot?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
DB_USERNAME=jobpilot
DB_PASSWORD=jobpilot
SERVER_PORT=9000
VITE_API_BASE_URL=http://localhost:9000

# Gmail SMTP (use a Gmail app password, never your regular Gmail password)
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional. Omit this line to use MAIL_USERNAME as the sender.
# MAIL_FROM=your-gmail-address@gmail.com

# ai-server(파이썬 크롤러) -> 백엔드 ingest API 인증용 공유 비밀키.
# ai-server/.env의 INTERNAL_API_KEY와 같은 값으로 맞춰서 각자 알아서 채우면 됨.
INTERNAL_API_KEY=

# never save external API secrets in MySQL
WORK24_SERVICE_KEY=
# 알라딘 OpenAPI TTBKey. 책 검색/상세/목록 API용이며 백엔드에서만 사용한다.
ALADIN_TTB_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OPENAI_API_KEY=

# 국세청 사업자등록정보 진위확인 API (공공데이터포털/data.go.kr, 무료).
# 비어있으면 기업회원 가입은 "확인 필요" 상태로 계속 진행된다(fail-open).
NTS_API_KEY=
# 기업회원이 등록한 채용공고 상세페이지 링크를 만들 때 쓰는 공개 도메인. 기본값은 운영 도메인.
# PUBLIC_BASE_URL=https://job-a-dream.site

# GitHub repository analysis (public repositories work without a token, but rate limits are lower)
GITHUB_TOKEN=
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OAuth client secrets are server-only values. Never prefix them with VITE_ and never commit real values.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_KAKAO_REST_API_KEY=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
